# The staff console address. With APP_DOMAIN set in .env (members on their
# own address), sign-in follows each request's address and this is ignored.
NEXTAUTH_URL="https://admin.your-domain.example"

# Change this to a long random secret before going live
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Encrypts staff two-factor (TOTP) secrets at rest: openssl rand -base64 32
# Keep it with your other secrets and back it up. If it is lost or
# changed, every staff member must set up two-factor authentication again.
MFA_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# Emailed on every Super Admin sign-in (break-glass alert to the board).
SECURITY_ALERT_EMAIL="board@your-domain.example"

# Emailed when the nightly ledger comparison (M5) finds a difference.
# Falls back to SECURITY_ALERT_EMAIL.
LEDGER_ALERT_EMAIL="treasurer@your-domain.example"

# Maker/checker (D-06) for Zelle confirmations over $100, withdrawals and
# loans. Leave off until the officers are named (Gate #1 A4); then set to
# "true". Manual journal entries always need a second person.
MAKER_CHECKER_ENFORCED="false"

# Late fees (Gate #1 A7): the daily loan job only reports the fees it would
# charge until counsel confirms the state's late-fee limits; then "true".
LATE_FEES_ENABLED="false"

# Ledger reads (migration step M6): "true" makes dashboards, statements,
# loan eligibility and loan balances read from the ledger instead of the
# stored figures. Turn it on only after 30 clean nightly comparisons that
# include a month-end, and the Board's review (Ledger -> Ledger reads).
# "false" switches back. Has no effect until opening balances are posted.
LEDGER_READS="false"

# The club's time zone (IANA name): decides which calendar day a payment or
# due date falls on.
CLUB_TIME_ZONE="America/Chicago"

# First month dues are billed month by month (YYYY-MM): where transaction-
# level contribution records begin. Members who joined later start then.
DUES_TRACKING_START="2026-01"

# PostgreSQL connection string for production
DATABASE_URL="postgresql://mcfinancial:change-me@postgres:5432/mcfinancial?schema=public"

# Optional email settings
RESEND_API_KEY="re_your_key_here"
ADMIN_EMAIL="your@email.com"
EMAIL_FROM="Millionaires Club <noreply@your-domain.example>"
ADMIN_SEED_EMAIL="admin@mcfinancial.local"
SUPPORT_EMAIL="support@mcfinancial.local"

# ── Online payments (member portal) ────────────────────────
# Use LIVE keys here, not test keys. STRIPE_WEBHOOK_SECRET comes from
# the webhook endpoint you create in the Stripe dashboard pointing at
# https://your-domain.example/api/webhooks/stripe
STRIPE_SECRET_KEY="sk_live_your_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_secret_here"

# Zelle has no payment API — these just control what instructions are
# shown to members; a Zelle "payment" is always confirmed manually by
# an admin against the club's actual bank activity.
ZELLE_RECIPIENT_NAME="Millionaires Club"
ZELLE_RECIPIENT_EMAIL="payments@your-domain.example"
# The club's Zelle QR code is a file, not a setting: put it at club/zelle-qr.png
# on the server (docs/operations/deploy-hetzner-postgres.md).

# Stripe posting failures and refund/dispute reconciliation alerts
PAYMENT_ALERT_EMAIL=

# Rules waiting for the board (src/modules/policy/boardRules.ts). Each is
# off unless "true"; until then the club's existing rules apply.
LOAN_COSIGNER_REQUIRED="false"
LOAN_COSIGNER_ELIGIBILITY="false"
LOAN_TERM_BANDS="false"
WITHDRAWAL_BLOCKED_BY_LOANS="false"
WITHDRAWAL_LIQUIDITY_CHECK="false"
FULL_EXIT_WHOLE_BALANCE="false"
