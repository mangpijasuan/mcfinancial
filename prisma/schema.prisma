generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Staff accounts (officers and administrators). What a staff member may
// do comes from their role assignments, read from the database on every
// request (src/modules/auth); role definitions live in
// src/modules/permissions.
model Admin {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  password       String
  linkedMemberId String?   @unique
  createdAt      DateTime  @default(now())
  disabledAt     DateTime?
  lastLoginAt    DateTime?

  // TOTP multi-factor authentication. Secrets are AES-256-GCM encrypted
  // with MFA_ENCRYPTION_KEY; mfaLastUsedStep blocks code replay.
  mfaSecret        String?
  mfaPendingSecret String?
  mfaEnabledAt     DateTime?
  mfaLastUsedStep  Int?

  roles         StaffRoleAssignment[]
  sessions      StaffSession[]
  recoveryCodes MfaRecoveryCode[]
}

model StaffRoleAssignment {
  id        String   @id @default(cuid())
  adminId   String
  role      String // a role key from src/modules/permissions
  grantedBy String? // staff id, or null for migrations and CLI
  grantedAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, role])
}

// Server-side staff sessions. The session cookie carries a random token;
// only its SHA-256 hash is stored here. A session ends after 12 hours, or
// 30 minutes without activity, or when revoked.
model StaffSession {
  id            String    @id // sha256(token)
  adminId       String
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  mfaVerifiedAt DateTime?
  revokedAt     DateTime?
  revokedReason String?
  ip            String?
  userAgent     String?

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  adminId   String
  codeHash  String    @unique // sha256 of the normalised code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model Member {
  id                       String    @id
  legalName                String
  nickname                 String?
  joinDate                 DateTime
  status                   String    @default("Active")
  phoneNo                  String?
  email                    String?
  beneficiary              String?
  notes                    String?
  archiveLifetime          Float     @default(0)
  contributions2026        Float     @default(0)
  overallContributions     Float     @default(0)
  monthsActive             Int       @default(0)
  maxLoanAmount            Float     @default(0)
  currentLoanBalance       Float     @default(0)
  eligible                 String    @default("NO")
  activeAsBorrower         Int       @default(0)
  activeAsCosigner         Int       @default(0)
  lastContributionDate     DateTime?
  thisMonth                String    @default("NOT PAID")
  riskFlag                 String    @default("LOW")
  portalEnabled            Boolean   @default(false)
  portalPassword           String?
  // Portal sessions issued before this moment are rejected (set when the
  // portal password changes or access is switched off).
  portalSessionsValidAfter DateTime?
  // Last month for which dues obligations were considered (created, or
  // skipped while inactive). Maintained by src/modules/contributions.
  duesThrough              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  contributions             Contribution[]
  duesPlans                 DuesPlan[]
  duesObligations           DuesObligation[]
  loansAsBorrower           Loan[]           @relation("Borrower")
  loansAsCosigner           Loan[]           @relation("Cosigner")
  historicalLoansAsBorrower HistoricalLoan[] @relation("HistoricalBorrower")
  historicalLoansAsCosigner HistoricalLoan[] @relation("HistoricalCosigner")
  loanPayments              LoanPayment[]
  yearlyTotals              YearlyTotal[]
  withdrawals               Withdrawal[]
  portalPayments            PortalPayment[]
}

model YearlyTotal {
  id       String @id @default(cuid())
  memberId String
  year     Int
  amount   Float  @default(0)
  member   Member @relation(fields: [memberId], references: [id])

  @@unique([memberId, year])
}

model Contribution {
  id             String   @id @default(cuid())
  transactionId  String   @unique
  memberId       String
  memberName     String
  paymentDate    DateTime
  monthYear      String
  amount         Float
  paymentMethod  String?
  receivedBy     String?
  comments       String?
  source         String?
  entryTimestamp DateTime @default(now())

  // Stage 3 (docs/architecture/04 §1). The payment date is when the money
  // arrived; which months it pays is derived from the member's dues
  // obligations (oldest unpaid first). Money fields never change after
  // recording (database trigger); a mistake is corrected by a reversal.
  amountCents    BigInt
  category       String    @default("dues") // dues | voluntary (not applied to dues)
  receiptNumber  String?   @unique // RC-YYYY-NNNNNN; rows recorded before receipts existed have none
  receiptCovers  String? // what the receipt said this payment covered when issued
  journalEntry   String? // once posted to the ledger
  reversedAt     DateTime?
  reversedBy     String? // staff id (maker of the reversal)
  reversalReason String?
  reversalEntry  String?

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, paymentDate])
}

/// What a member is expected to pay each month, from a period onwards.
/// A change adds a row (history is kept); it applies from its start month.
model DuesPlan {
  id          String   @id @default(cuid())
  memberId    String
  amountCents BigInt
  startPeriod String // YYYY-MM
  note        String?
  createdBy   String? // staff id; null for the initial plan
  createdAt   DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@unique([memberId, startPeriod])
}

/// One month's dues for one member, created while the member is active.
/// Payments cover obligations oldest first (src/modules/contributions/dues.ts).
model DuesObligation {
  id          String   @id @default(cuid())
  memberId    String
  period      String // YYYY-MM
  amountCents BigInt
  createdAt   DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@unique([memberId, period])
  @@index([period])
}

model Loan {
  id               String    @id @default(cuid())
  loanId           String    @unique
  borrowerId       String
  borrowerName     String
  cosignerId       String?
  cosignerName     String?
  loanDate         DateTime
  termMonths       Int
  loanAmount       Float
  monthlyDue       Float
  totalPaid        Float     @default(0)
  balanceRemaining Float
  status           String    @default("Active")
  endDate          DateTime?
  nextDueDate      DateTime?
  overdue          Boolean   @default(false)
  notes            String?
  // live: made in this app; legacy_import: moved from the 2021–2025 records (M9)
  origin           String    @default("live")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Lifecycle (docs/architecture/04 §2). Loans made before the loan engine
  // have no stored schedule (principalCents is null) and keep today's
  // hand-kept fields until their schedules are backfilled. createLoan sets
  // "approved"; the default is for rows imported by the seed and the
  // legacy scripts, which were all paid out long ago.
  lifecycle             String    @default("disbursed") // approved | agreement_signed | disbursed | paid_off | charged_off | cancelled
  principalCents        BigInt?
  applicationFeeCents   BigInt?
  policyVersion         String?
  dueDay                Int?
  graceDays             Int?
  disbursedOn           DateTime? @db.Date
  disbursedAmountCents  BigInt? // principal minus the application fee (Gate #1 A8)
  disbursementMethod    String?
  disbursementReference String?
  disbursedBy           String? // staff id (maker)
  disbursementEntry     String? // journal entry number, once posted
  delinquency           String? // current | delinquent — set only by the servicing job
  daysPastDue           Int       @default(0)
  servicedOn            DateTime? @db.Date // last run of the servicing job for this loan
  chargedOffOn          DateTime? @db.Date
  chargeOffEntry        String?
  cancelledAt           DateTime?

  borrower     Member            @relation("Borrower", fields: [borrowerId], references: [id])
  cosigner     Member?           @relation("Cosigner", fields: [cosignerId], references: [id])
  payments     LoanPayment[]
  agreement    LoanAgreement?
  installments LoanInstallment[]
  fees         LoanFee[]

  @@index([lifecycle])
}

/// One row per scheduled installment, from the loan engine at creation.
/// Immutable (a database trigger refuses changes); a restructure will add
/// a new schedule version rather than edit this one.
model LoanInstallment {
  id             String   @id @default(cuid())
  loanId         String
  number         Int
  dueDate        DateTime @db.Date
  principalCents BigInt
  interestCents  BigInt   @default(0)
  createdAt      DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [loanId])

  @@unique([loanId, number])
}

/// A fee charged on a loan: today only late fees, at most one per
/// installment (unique), waivable with a checker.
model LoanFee {
  id                String    @id @default(cuid())
  feeId             String    @unique // FEE-XXXXXXXXXX
  loanId            String
  installmentNumber Int
  kind              String    @default("late_fee")
  amountCents       BigInt
  assessedOn        DateTime  @db.Date
  status            String    @default("charged") // charged | waived
  journalEntry      String?
  waivedOn          DateTime? @db.Date
  waivedAt          DateTime? // when the waiver was recorded (orders it among payments)
  waivedBy          String? // staff id (maker of the waiver)
  waiverReason      String?
  waiverEntry       String?
  eventSeq          BigInt    @default(dbgenerated("next_loan_event()"))
  waiverSeq         BigInt? // set by the database when the fee is waived
  createdAt         DateTime  @default(now())

  loan Loan @relation(fields: [loanId], references: [loanId])

  @@unique([loanId, installmentNumber, kind])
}

model LoanPayment {
  id            String   @id @default(cuid())
  paymentId     String   @unique
  loanId        String
  borrowerId    String
  borrowerName  String
  paymentDate   DateTime
  amount        Float
  paymentMethod String?
  receivedBy    String?
  comments      String?
  source        String?
  monthYear     String?
  createdAt     DateTime @default(now())
  journalEntry  String? // once posted to the ledger (loans on the loan engine)
  eventSeq      BigInt   @default(dbgenerated("next_loan_event()")) // recording order (see src/modules/loans/state.ts)

  loan     Loan   @relation(fields: [loanId], references: [loanId])
  borrower Member @relation(fields: [borrowerId], references: [id])
}

// Loans from the 2021–2025 records. The original fields are kept as they
// were; M9 links each loan to its members by ID (never by name) and, for a
// loan still marked Active, records the balance the Treasurer confirmed and
// the live loan it was moved to (src/modules/loans/history.ts).
model HistoricalLoan {
  id               String    @id @default(cuid())
  loanId           String    @unique
  year             Int
  borrowerName     String
  cosignerName     String?
  loanDate         DateTime
  endDate          DateTime?
  loanAmount       Float
  totalPaid        Float     @default(0)
  balanceRemaining Float     @default(0)
  status           String    @default("Paid Off")
  createdAt        DateTime  @default(now())

  borrowerId            String?
  cosignerId            String?
  borrowerLink          String? // exact | reviewed | no_member; null = not linked yet
  cosignerLink          String? // the same, for a loan with a co-signer
  confirmedBalanceCents BigInt? // the Treasurer's figure, for a loan marked Active
  balanceAsOf           DateTime? @db.Date
  balanceConfirmedBy    String? // staff id
  balanceConfirmedAt    DateTime?
  importedLoanId        String?   @unique // the live loan carrying the balance, if any

  borrower Member? @relation("HistoricalBorrower", fields: [borrowerId], references: [id], onDelete: Restrict)
  cosigner Member? @relation("HistoricalCosigner", fields: [cosignerId], references: [id], onDelete: Restrict)

  @@index([borrowerId])
  @@index([cosignerId])
}

model Withdrawal {
  id             String   @id @default(cuid())
  withdrawalId   String   @unique
  memberId       String
  memberName     String
  amount         Float
  withdrawalDate DateTime
  type           String   @default("Partial") // "Partial" | "Full Exit"
  reason         String?
  processedBy    String?
  notes          String?
  createdAt      DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])
}

model EmailLog {
  id        String   @id @default(cuid())
  type      String // "contribution_reminder" | "loan_overdue" | "admin_summary"
  recipient String
  subject   String
  status    String   @default("sent") // "sent" | "failed"
  sentAt    DateTime @default(now())
}

model LoanAgreement {
  id          String @id @default(cuid())
  agreementId String @unique
  loanId      String @unique

  borrowerName    String
  borrowerId      String
  borrowerAddress String?
  borrowerCity    String?
  borrowerState   String?

  cosignerName String?
  cosignerId   String?

  lenderName     String @default("Millionaires Club")
  applicationFee Float  @default(0)

  loanAmount     Float
  monthlyPayment Float
  termMonths     Int
  startDate      DateTime
  endDate        DateTime

  borrowerSignature  String?
  borrowerSignedAt   DateTime?
  cosignerSignature  String?
  cosignerSignedAt   DateTime?
  lenderSignature    String?
  lenderSignedAt     DateTime?
  // SHA-256 of the agreement terms each party signed, so the signed text
  // is provable (docs/architecture/04 §2).
  termsHash          String?
  borrowerSignedHash String?
  cosignerSignedHash String?
  lenderSignedHash   String?
  amountPaidOut      Float? // loan amount minus the application fee (Gate #1 A8)

  status String @default("pending")
  // pending | borrower_signed | cosigner_signed | fully_signed

  createdAt DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [loanId])
}

// Member-initiated online payments (Stripe checkout or a claimed Zelle
// transfer). Stripe rows are completed automatically by the webhook;
// Zelle rows sit "pending" until an admin confirms them against their
// bank activity — Zelle has no merchant API, so there is no way to
// verify a Zelle payment happened without a human checking.
model PortalPayment {
  id                    String    @id @default(cuid())
  publicId              String    @unique
  memberId              String
  type                  String // "contribution" | "loan_payment"
  loanId                String?
  amount                Float
  method                String // "stripe" | "zelle"
  status                String    @default("pending") // "pending" | "completed" | "rejected" | "failed"
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  zelleReference        String?
  rejectionReason       String?
  reviewedBy            String?
  reviewedAt            DateTime?
  contributionId        String?
  loanPaymentId         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  member Member @relation(fields: [memberId], references: [id])
}

// Append-only record of who changed what. A database trigger rejects
// UPDATE, DELETE and TRUNCATE on this table (migration
// 20260926010000_audit_log), so entries cannot be edited or removed
// through the application. Written in the same transaction as the change
// it describes. Secrets (password hashes, tokens) are redacted before
// they are stored — see src/modules/audit.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  actorType  String // "admin" | "member" | "system" | "anonymous"
  actorId    String?
  actorLabel String?
  action     String // e.g. "member.update", "payment.zelle.confirm"
  entityType String
  entityId   String
  before     Json?
  after      Json?
  metadata   Json?
  requestId  String?
  ip         String?
  userAgent  String?

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([at])
}

// Failed sign-in and verification attempts, for rate limiting (S-5). Kept
// in the database so limits survive restarts and apply across instances.
// Rows older than a day are pruned as new failures are recorded.
model RateLimitAttempt {
  id  BigInt   @id @default(autoincrement())
  key String // "admin:<email>", "member:<id>", "mfa:<staff id>", "ip:<address>", …
  at  DateTime @default(now())

  @@index([key, at])
  @@index([at])
}

// ── General ledger (D-04) ─────────────────────────────────────────────
// Double-entry books in integer cents (D-03). The database enforces the
// invariants (migration 20260927010000_ledger): every entry balances,
// posted entries and lines can never be changed or deleted, lines only
// post to APPROVED accounts, and nothing posts into a closed period.
// Proposals awaiting approval live elsewhere (approvals); every row here
// is posted and final. Corrections are reversing entries (D-05).

model LedgerAccount {
  code          String    @id // "1000"
  name          String
  type          String // asset | contra_asset | liability | equity | income | expense
  normalBalance String // debit | credit
  subledger     String? // member | loan | collector | bank: lines must name one
  description   String?
  // "proposed" until the club's accountant confirms the chart (Gate #1 A13).
  // The ledger accepts postings only to approved accounts.
  status        String    @default("proposed") // proposed | approved | retired
  approvedAt    DateTime?
  approvedBy    String? // staff id who recorded the approval
  approvalNote  String? // e.g. "Confirmed by <accountant>, letter of <date>"
  createdAt     DateTime  @default(now())

  lines JournalLine[]
}

model JournalEntry {
  id              String   @id @default(cuid())
  entryNumber     String   @unique // JE-2026-000123
  effectiveDate   DateTime @db.Date
  type            String // contribution | loan_disbursement | loan_repayment | fee | withdrawal | adjustment | reversal | opening_balance | …
  description     String
  reference       String? // bank reference, Stripe event id, receipt number
  sourceType      String?
  sourceId        String?
  idempotencyKey  String   @unique
  requestHash     String // detects an idempotency key reused for a different entry
  reversesEntryId String?  @unique // at most one reversal per entry
  currency        String   @default("USD")
  createdBy       String? // staff id, or null for the system
  approvedBy      String? // checker, when maker/checker applied (D-06)
  postedAt        DateTime @default(now())

  lines      JournalLine[]
  reverses   JournalEntry? @relation("Reversal", fields: [reversesEntryId], references: [id])
  reversedBy JournalEntry? @relation("Reversal")

  @@index([effectiveDate])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id          String  @id @default(cuid())
  entryId     String
  lineNo      Int
  accountCode String
  memberId    String?
  loanId      String?
  debitCents  BigInt  @default(0)
  creditCents BigInt  @default(0)
  memo        String?

  entry   JournalEntry  @relation(fields: [entryId], references: [id])
  account LedgerAccount @relation(fields: [accountCode], references: [code])

  @@unique([entryId, lineNo])
  @@index([accountCode, memberId])
  @@index([memberId])
  @@index([loanId])
}

// Accounting periods ("2026-09"). A closed period accepts no entries;
// corrections go into the current period.
model LedgerPeriod {
  period   String    @id
  status   String    @default("open") // open | closed
  closedAt DateTime?
  closedBy String?
}

// ── Maker / checker (D-06) ────────────────────────────────────────────
// A proposed operation waiting for a second, different, authorised person.
// On approval the operation runs in the same transaction; on rejection or
// cancellation nothing happens. At most one pending request per action and
// entity (partial unique index in migration 20260927020000_approvals).
model ApprovalRequest {
  id                String    @id @default(cuid())
  publicId          String    @unique // APR-XXXXXXXXXX
  action            String // see src/modules/approvals/policy.ts
  entityType        String
  entityId          String
  summary           String
  amountCents       BigInt?
  payload           Json
  status            String    @default("pending") // pending | approved | rejected | cancelled
  approvalsRequired Int       @default(1)
  requestedBy       String // staff id (the maker)
  requestedAt       DateTime  @default(now())
  decidedAt         DateTime?
  decisionNote      String?
  resultRef         String? // what the approved operation created, e.g. a withdrawal or entry number

  decisions ApprovalDecision[]

  @@index([status, requestedAt])
  @@index([entityType, entityId])
}

model ApprovalDecision {
  id        String   @id @default(cuid())
  requestId String
  deciderId String // staff id (a checker)
  decision  String // approve | reject
  note      String?
  at        DateTime @default(now())

  request ApprovalRequest @relation(fields: [requestId], references: [id])

  @@unique([requestId, deciderId])
}

// A bank balance the Treasurer read from the club's bank statement or
// online banking (docs/architecture/08 §1). Until the ledger holds the
// club's cash (opening balances, M4), the latest one, rolled forward with
// the money recorded since, is the cash figure behind the cash reserve
// and lending capacity (Gate #1 A10). Never changed or deleted (database
// trigger); a newer balance supersedes it.
model TreasuryBankBalance {
  id            String   @id @default(cuid())
  balanceId     String   @unique // BB-…
  statementDate DateTime @db.Date // the balance is at the end of this day
  balanceCents  BigInt
  note          String?
  recordedBy    String // staff id (maker)
  approvedBy    String? // checker, when maker/checker applied (D-06)
  createdAt     DateTime @default(now())

  @@index([statementDate])
}

// The nightly comparison of the ledger with the old records (migration
// step M5, docs/architecture/11 §1). The ledger becomes the system of
// record after 30 consecutive clean days, including a month-end. Kept as
// evidence: never changed or deleted (database trigger).
model LedgerComparison {
  id          String   @id @default(cuid())
  runDate     DateTime @db.Date // the club day compared
  ranAt       DateTime @default(now())
  ok          Boolean
  differences Int
  details     Json // what differed: invariants, member capital, loans, unposted records
  emailedTo   String? // where the alert went, when there were differences

  @@index([runDate])
}

// Money moved from a clearing account to the bank (F-11): a Stripe payout,
// Zelle/transfer receipts swept to the bank, or cash a collector deposited.
// Posts Dr 1000 Bank / Cr the clearing account. Never changed or deleted.
model ClearingTransfer {
  id           String   @id @default(cuid())
  transferId   String   @unique // TR-…
  fromAccount  String // 1010 | 1020 | 1030
  amountCents  BigInt
  bankDate     DateTime @db.Date // the day it reached the bank (as on the statement)
  reference    String? // deposit slip, Stripe payout id, bank reference
  collector    String? // for cash: who deposited it (as recorded in receivedBy)
  note         String?
  journalEntry String
  recordedBy   String // staff id (maker)
  approvedBy   String? // checker, when maker/checker applied (D-06)
  createdAt    DateTime @default(now())

  @@index([fromAccount, bankDate])
}

// A month's bank reconciliation (F-11): the bank statement balance at the
// month end, adjusted for deposits in transit and outstanding payments,
// against the ledger's bank account (1000). A month closes only when the
// latest one shows no difference. Never changed; redo it to correct it.
model BankReconciliation {
  id                    String   @id @default(cuid())
  seq                   BigInt   @unique @default(autoincrement()) // recording order; the latest per month counts
  period                String // YYYY-MM
  statementDate         DateTime @db.Date // the month's last day
  statementBalanceCents BigInt
  ledgerBalanceCents    BigInt
  items                 Json // [{ kind: deposit_in_transit | outstanding_payment, description, cents }]
  differenceCents       BigInt // (statement + in transit − outstanding) − ledger
  note                  String?
  preparedBy            String // staff id
  createdAt             DateTime @default(now())

  @@index([period, seq])
}
