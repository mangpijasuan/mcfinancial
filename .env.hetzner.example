# Copy to .env (next to docker-compose.hetzner.yml). Docker Compose reads it
# automatically, so these survive reboots and new SSH sessions.

# The address the club uses for the admin panel. Its DNS A record must
# point at this server before the first start, so Caddy can get a certificate.
DOMAIN=admin.your-domain.example

# The address members use for the portal, e.g. app.your-domain.example.
# Its DNS A record must point at this server too. Once set, members sign in
# only there and staff only at DOMAIN, each with their own session (D-17).
# Leave it empty to serve both from DOMAIN.
APP_DOMAIN=

# The public website (apps/web), e.g. "your-domain.example www.your-domain.example".
# Its DNS A records must point at this server. Leave it empty until the site's
# wording is final and counsel has reviewed it (apps/web/README.md). Needs
# APP_DOMAIN, where "Member sign in" leads.
WWW_DOMAIN=

# Database password: openssl rand -hex 24
# Left empty on purpose: the stack refuses to start until it is set. Use
# the same value in DATABASE_URL in .env.production. It only takes effect
# when the database is first created; to change it later, see the deploy
# guide.
POSTGRES_PASSWORD=
