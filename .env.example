# -------------------------------------------------------
# COPY THIS FILE to .env.local  (setup.sh does this for you)
# Local PostgreSQL runs in Docker: npm run db:up
# -------------------------------------------------------

# PostgreSQL (docker-compose.postgres-local.yml; dev-only credentials)
DATABASE_URL="postgresql://mcfinancial:mcfinancial_dev@127.0.0.1:5434/mcfinancial?schema=public"

# Secret for login sessions. setup.sh generates one; otherwise run
#   openssl rand -base64 32
NEXTAUTH_SECRET=""

# Encrypts staff two-factor (TOTP) secrets at rest. 32 random bytes,
# base64. setup.sh generates one; otherwise run: openssl rand -base64 32
# Changing it later makes every enrolled authenticator stop working.
MFA_ENCRYPTION_KEY=""

# Optional: emailed whenever someone signs in with Super Admin access.
SECURITY_ALERT_EMAIL=""
# Nightly ledger comparison alerts (M5); falls back to SECURITY_ALERT_EMAIL.
LEDGER_ALERT_EMAIL=""

# Maker/checker (D-06) for Zelle confirmations over $100, withdrawals and
# loans. Leave off until the officers are named (Gate #1 A4); then set to
# "true". Manual journal entries always need a second person.
MAKER_CHECKER_ENFORCED=""

# Late fees (Gate #1 A7): the daily loan job only reports the fees it would
# charge until counsel confirms the state's late-fee limits; then "true".
LATE_FEES_ENABLED=""

# Ledger reads (migration step M6): "true" makes dashboards, statements,
# loan eligibility and loan balances read from the ledger instead of the
# stored figures. Turn it on only after 30 clean nightly comparisons that
# include a month-end, and the Board's review (Ledger -> Ledger reads).
# "false" switches back. Has no effect until opening balances are posted.
LEDGER_READS=""

# The club's time zone (IANA name): decides which calendar day a payment or
# due date falls on.
CLUB_TIME_ZONE="America/Chicago"

# First month dues are billed month by month (YYYY-MM): where transaction-
# level contribution records begin. Members who joined later start then.
DUES_TRACKING_START="2026-01"

# Password for the seeded admin account (at least 12 characters).
# Seeding refuses to run without it.
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_EMAIL="admin@mcfinancial.local"
SUPPORT_EMAIL="support@mcfinancial.local"

# URL of your app
NEXTAUTH_URL="http://localhost:3000"

# ── Email notifications (Phase 4) ──────────────────────────
# Sign up free at resend.com — no credit card, 3000 emails/month
RESEND_API_KEY="re_your_key_here"

# Where admin summary emails get sent
ADMIN_EMAIL="your@email.com"

# ── Online payments (member portal) ────────────────────────
# Stripe: sign up free at stripe.com, use TEST keys while developing
# (dashboard → Developers → API keys). Card payments won't work until
# both of these are set.
STRIPE_SECRET_KEY="sk_test_your_key_here"
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (Stripe CLI) while developing, or the webhook's signing secret in
# the dashboard once deployed.
STRIPE_WEBHOOK_SECRET="whsec_your_secret_here"

# Zelle has no payment API — members submit a claim in the portal and
# an admin confirms it after checking the club's bank. These just
# control what instructions are shown to members (safe to leave blank).
NEXT_PUBLIC_ZELLE_RECIPIENT_NAME="Millionaires Club"
NEXT_PUBLIC_ZELLE_RECIPIENT_EMAIL="payments@your-domain.example"
